@section Scripts
{
    <script type="module">
        import { displayResponse, get } from "/js/ApiCalls.js";

        async function getClaims() {
            const response = await get(`Task03/GetClaims`);
            await displayResponse(response);
        }

        document.querySelector('#get-claims').addEventListener('click', getClaims);
    </script>
}

@{
    <form class="row g-3">
        <div class="col-auto">
            <button id="get-claims" class="btn btn-primary mb-3" type="button">Get User Claims</button>
        </div>
    </form>

    <partial name="_ResponseDisplay" />
}