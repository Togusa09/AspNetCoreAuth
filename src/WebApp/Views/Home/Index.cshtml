@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    
    @if (!User.Identity!.IsAuthenticated)
    {
        <div style="display:flex; flex-direction:column" >
            
                <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Scott">Login as Scott</a>

                <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Gordon">Login as Gordon</a>

                <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="John">Login as John</a>
       
                <a class="text-dark" asp-area="" asp-controller="Login" asp-action="LoginOidc">Login with OIDC</a>
   
        </div>
    }
    else
    {
        <h2>@(User.Identity.Name)</h2>
    }
</div>
