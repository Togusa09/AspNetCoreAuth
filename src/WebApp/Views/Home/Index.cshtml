@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    <p>Learn about <a href="https://learn.microsoft.com/aspnet/core">building Web apps with ASP.NET Core</a>.</p>
    
    @if (!User.Identity!.IsAuthenticated)
    {
        <div style="display:flex; flex-direction:column" >
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Wally">Login as Wally</a>
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Deke">Login as Deke</a>
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="LoginOidc">Login with OIDC</a>
        </div>
    }
    else
    {
        <h2>@(User.Identity.Name)</h2>
    }
</div>
