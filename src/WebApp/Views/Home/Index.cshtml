@using System.Security.Claims
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1 class="display-4">Welcome</h1>
    
    @if (!User.Identity!.IsAuthenticated)
    {
        <div style="display:flex; flex-direction:column" >
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Wally" asp-route-familyName="Schirra ">Login as Wally</a>
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Deke" asp-route-familyName="Slayton">Login as Deke</a>
            @* <a class="text-dark" asp-area="" asp-controller="Login" asp-action="LoginOidc">Login with OIDC</a> *@
        </div>
    }
    else
    {
        <h2>@(User.Identity.Name)</h2>

        @* <ul> *@
        @* @foreach (var claim in (User.Identity as ClaimsIdentity).Claims) *@
        @* { *@
        @*     <li>@($"{claim.Type} - {claim.Value}")</li> *@
        @* } *@
        @* </ul> *@
    }
</div>
