@using System.Security.Claims
@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center">
    <h1>ASP.Net Auth Workshop</h1>

    <h2>User</h2>
    @if (!User.Identity!.IsAuthenticated)
    {
        <div style="display:flex; flex-direction:column" >
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Wally" asp-route-familyName="Schirra">Login as Wally</a>
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="Login" asp-route-name="Deke" asp-route-familyName="Slayton">Login as Deke</a>
            <a class="text-dark" asp-area="" asp-controller="Login" asp-action="LoginOidc">Login with OIDC</a>
        </div>
    }
    else
    {
        <h2>@(User.Identity.Name)</h2>
    }
    
    <h2>Workshop Tasks</h2>
    <div style="display:flex; flex-direction:column">
        <a class="text-dark" asp-area="" asp-controller="Task02" asp-action="Index">Task Two</a>
        <a class="text-dark" asp-area="" asp-controller="Task03" asp-action="Index">Task Three</a>
        <a class="text-dark" asp-area="" asp-controller="Task03" asp-action="Index">Task Four</a>
        <a class="text-dark" asp-area="" asp-controller="Task05" asp-action="Index">Task Five</a>
        <a class="text-dark" asp-area="" asp-controller="Task06" asp-action="Index">Task Six</a>
        <a class="text-dark" asp-area="" asp-controller="Task07" asp-action="Index">Task Seven</a>
        <a class="text-dark" asp-area="" asp-controller="Task08" asp-action="Index">Task Eight A</a>
        <a class="text-dark" asp-area="" asp-controller="Task08" asp-action="SensitivePage">Task Eight B</a>
    </div>
</div>
