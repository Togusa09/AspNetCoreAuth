@section Scripts
{
    <script type="module" src="~/js/ClaimsClient.js"></script>
}

@{
    <form>
        <div class="mb-3">
            <button id="get-no-auth" class="btn btn-primary" type="button">No Auth</button>
        </div>
        <div class="mb-3">
            <button id="get-auth" class="btn btn-primary" type="button">Auth</button>
        </div>
        <div class="mb-3">
            <button id="get-pilot" class="btn btn-primary" type="button">Test Pilot</button>
        </div>
        <div class="mb-3">
            <button id="get-engineer" class="btn btn-primary" type="button">Test Engineer</button>
        </div>
    </form>

    <div class="card">
        <div class="card-body">
            <div>
                Response Status:
                <span id="response-status"></span>
            </div>
            <div id="response-content"></div>
        </div>
    </div>
}