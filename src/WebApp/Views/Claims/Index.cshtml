@section Scripts
{
    <script type="module" src="~/js/ClaimsClient.js"></script>
}

@{
    <form class="row g-3">
        <div class="col-auto">
            <button id="get-no-auth" class="btn btn-primary mb-3" type="button">Get User Info</button>
        </div>
        <div class="col-auto">
            <button id="get-auth" class="btn btn-primary mb-3" type="button">Get Authed User Info</button>
        </div>
        <div class="col-auto">
            <button id="get-pilot" class="btn btn-primary mb-3" type="button">Test Pilot Role</button>
        </div>
        <div class="col-auto">
            <button id="get-engineer" class="btn btn-primary mb-3" type="button">Test Engineer Role</button>
        </div>
    </form>

    <div class="card row">
        <div class="card-body">
            <div>
                Response Status:
                <span id="response-status"></span>
            </div>
            <pre><code id="response-content"></code></pre>
        </div>
    </div>
}