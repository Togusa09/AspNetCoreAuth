@section Scripts
{
    <script type="module" src="~/js/ResourceAuthPolicyClient.js"></script>
}

@{
    <form>
        <div class="mb-3">
            <label for="launch-site" class="col-sm-2 col-form-label">Launch Site</label>
            <select id="launch-site" class="form-select">
                <option value="CapeCanaveral">Cape Canaveral</option>
                <option value="KennedySpaceCentre">Kennedy Space Centre</option>
                <option value="TracyIsland">Tracy Island</option>
            </select>
        </div>

        <div class="mb-3">
            <button id="get-craft" class="btn btn-primary" type="button">Get Craft</button>
        </div>

        <div class="mb-3">
            <label for="craft-list" class="col-sm-2 col-form-label">Craft Lift</label>
            <select id="craft-list" class="form-select">
                <option>N/A</option>
            </select>
        </div>

        <div class="mb-3">
            <button id="get-craft-detail" class="btn btn-primary" type="button">Get Craft Detail</button>
        </div>
    </form>

    <div class="card">
        <div class="card-body">
            <div>
                Response Status:
                <span id="response-status"></span>
            </div>
            <div id="response-content"></div>
        </div>
    </div>
}